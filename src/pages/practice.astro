---
import Layout from '../layouts/Layout.astro';
import questionsData from '../data/questions.json';
import type { RawQuestion } from '../types/question';

const questions = questionsData as RawQuestion[];
---
<Layout title="Practice Mode – Exam Simulator">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-slate-400 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Home
        </a>
        <span class="text-sm font-semibold text-slate-700">Practice Mode</span>
        <div class="flex items-center gap-3">
          <span id="question-counter" class="text-sm text-slate-500 font-medium" aria-live="polite">1 / {questions.length}</span>
          <button
            id="save-btn"
            onclick="finishSession()"
            class="text-sm font-semibold px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors cursor-pointer"
            aria-label="Save practice session"
          >
            Save
          </button>
        </div>
      </div>
      <div class="h-1 bg-slate-100" role="progressbar" aria-label="Practice progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="progress-bar" class="h-1 bg-blue-500 transition-all duration-300" style="width: 0%"></div>
      </div>
    </header>

    <!-- Error banner -->
    <div
      id="error-banner"
      class="hidden max-w-3xl mx-auto w-full px-4 pt-4"
      role="alert"
      aria-live="assertive"
    >
      <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <span id="error-banner-text">Could not save session.</span>
      </div>
    </div>

    <!-- Keyboard hint -->
    <div class="max-w-3xl mx-auto w-full px-4 pt-3 pb-0">
      <p class="text-xs text-slate-400">
        Keyboard: <kbd class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 font-mono">Space</kbd> Check answer &nbsp;
        <kbd class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 font-mono">←</kbd> Previous &nbsp;
        <kbd class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 font-mono">→</kbd> Next
      </p>
    </div>

    <!-- Main content -->
    <main id="main-content" class="flex-1 max-w-3xl mx-auto w-full px-4 py-8" tabindex="-1">
      <div id="question-area"></div>
    </main>
  </div>
</Layout>

<script>
  import { normalizeQuestions, escapeHtml, isAnswerCorrect } from '../lib/questionUtils';
  import { saveAttempt } from '../lib/db';
  import type { RawQuestion } from '../types/question';
  import questionsRaw from '../data/questions.json';

  const sessionStartTime = Date.now();

  const questions = normalizeQuestions(questionsRaw as unknown as RawQuestion[]);
  const selectedAnswers: Set<string>[] = questions.map(() => new Set());
  const checkedState: boolean[] = questions.map(() => false);

  let currentIdx = 0;

  const counter = document.getElementById('question-counter') as HTMLElement;
  const progressBarWrapper = document.getElementById('progress-bar')!.parentElement as HTMLElement;
  const progressBar = document.getElementById('progress-bar') as HTMLElement;
  const area = document.getElementById('question-area') as HTMLElement;
  const errorBanner = document.getElementById('error-banner') as HTMLElement;
  const errorBannerText = document.getElementById('error-banner-text') as HTMLElement;

  function showError(message: string): void {
    errorBannerText.textContent = message;
    errorBanner.classList.remove('hidden');
  }

  function updateHeader(): void {
    counter.textContent = `${currentIdx + 1} / ${questions.length}`;
    const pct = ((currentIdx + 1) / questions.length) * 100;
    progressBar.style.width = `${pct}%`;
    progressBarWrapper.setAttribute('aria-valuenow', String(Math.round(pct)));
  }

  function optionClass(
    letter: string,
    isChecked: boolean,
    selected: Set<string>,
    answer: string[]
  ): string {
    const base = 'w-full text-left px-5 py-4 rounded-xl border-2 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 ';
    if (!isChecked) {
      return base + (selected.has(letter)
        ? 'border-blue-500 bg-blue-50 text-slate-800 cursor-pointer'
        : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50 cursor-pointer');
    }
    const isCorrect = answer.includes(letter);
    const wasSelected = selected.has(letter);
    if (isCorrect && wasSelected) return base + 'border-green-500 bg-green-50 text-green-900';
    if (isCorrect && !wasSelected) return base + 'border-green-400 bg-green-50 text-green-900';
    if (!isCorrect && wasSelected) return base + 'border-red-500 bg-red-50 text-red-900';
    return base + 'border-slate-200 bg-white text-slate-400 cursor-default';
  }

  function optionIcon(
    letter: string,
    isChecked: boolean,
    selected: Set<string>,
    answer: string[]
  ): string {
    if (!isChecked) {
      return selected.has(letter)
        ? `<span class="w-6 h-6 rounded-full border-2 border-blue-500 bg-blue-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </span>`
        : `<span class="w-6 h-6 rounded-full border-2 border-slate-300 bg-white flex-shrink-0" aria-hidden="true"></span>`;
    }
    const isCorrect = answer.includes(letter);
    const wasSelected = selected.has(letter);
    if (isCorrect) {
      return `<span class="w-6 h-6 rounded-full border-2 border-green-500 bg-green-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </span>`;
    }
    if (wasSelected) {
      return `<span class="w-6 h-6 rounded-full border-2 border-red-500 bg-red-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </span>`;
    }
    return `<span class="w-6 h-6 rounded-full border-2 border-slate-300 bg-white flex-shrink-0" aria-hidden="true"></span>`;
  }

  function renderQuestion(): void {
    const q = questions[currentIdx];
    const selected = selectedAnswers[currentIdx];
    const isChecked = checkedState[currentIdx];

    const optionsHtml = q.options.map(([letter, text]) => {
      const cls = optionClass(letter, isChecked, selected, q.answer);
      const icon = optionIcon(letter, isChecked, selected, q.answer);
      const isCorrectOpt = q.answer.includes(letter);
      const wasSelected = selected.has(letter);
      let ariaLabel = `Option ${letter}: ${escapeHtml(text)}`;
      if (isChecked) {
        if (isCorrectOpt && wasSelected) ariaLabel += ' — correct, you selected this';
        else if (isCorrectOpt) ariaLabel += ' — correct answer';
        else if (wasSelected) ariaLabel += ' — incorrect, you selected this';
      }
      return `
        <button
          class="${cls}"
          data-letter="${letter}"
          ${isChecked ? 'disabled aria-disabled="true"' : ''}
          onclick="handleOptionClick('${letter}')"
          aria-pressed="${selected.has(letter)}"
          aria-label="${ariaLabel}"
        >
          <div class="flex items-start gap-3">
            ${icon}
            <span class="leading-relaxed text-sm">${escapeHtml(text)}</span>
          </div>
        </button>
      `;
    }).join('');

    const checkBtnHtml = !isChecked
      ? `<button
          id="check-btn"
          onclick="checkAnswer()"
          ${selected.size === 0 ? 'disabled aria-disabled="true"' : ''}
          class="px-6 py-2.5 rounded-xl font-semibold text-sm transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2
            ${selected.size > 0
              ? 'bg-blue-600 text-white hover:bg-blue-700 cursor-pointer'
              : 'bg-slate-200 text-slate-400 cursor-not-allowed'}"
        >
          Check Answer
        </button>`
      : '';

    const explanationHtml = isChecked
      ? `<div class="mt-5 p-5 bg-slate-50 border border-slate-200 rounded-xl" role="region" aria-label="Explanation">
          ${q.paraphrase ? `<p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">In a nutshell</p>
          <p class="text-slate-800 text-sm font-medium leading-relaxed mb-4 whitespace-pre-line">${escapeHtml(q.paraphrase)}</p>` : ''}
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Explanation</p>
          <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-line">${escapeHtml(q.explanation)}</p>
        </div>`
      : '';

    const resultBadge = isChecked
      ? (() => {
          const correct = isAnswerCorrect(selected, q.answer);
          return correct
            ? `<span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full" role="status">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Correct
              </span>`
            : `<span class="inline-flex items-center gap-1.5 bg-red-100 text-red-700 text-xs font-semibold px-3 py-1 rounded-full" role="status">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                Incorrect
              </span>`;
        })()
      : '';

    const prevDisabled = currentIdx === 0;
    const nextDisabled = currentIdx === questions.length - 1;

    area.innerHTML = `
      <div>
        ${q.topic ? `<div class="mb-3"><span class="text-xs font-semibold text-blue-600 bg-blue-50 border border-blue-100 px-2.5 py-1 rounded-full">${escapeHtml(q.topic)}</span></div>` : ''}

        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Question ${currentIdx + 1}</span>
          ${q.isMulti ? `<span class="text-xs bg-amber-100 text-amber-700 font-semibold px-2.5 py-0.5 rounded-full">Select ${q.answer.length} answers</span>` : ''}
          ${resultBadge}
        </div>

        <h2 class="text-lg font-semibold text-slate-800 mb-6 leading-relaxed whitespace-pre-line">
          ${escapeHtml(q.question)}
        </h2>

        <div class="flex flex-col gap-3 mb-6" role="group" aria-label="Answer options">
          ${optionsHtml}
        </div>

        <div class="flex items-center justify-between">
          <div>${checkBtnHtml}</div>
        </div>

        ${explanationHtml}

        <div class="flex items-center justify-between mt-8 pt-6 border-t border-slate-200">
          <button
            id="prev-btn"
            onclick="navigate(-1)"
            ${prevDisabled ? 'disabled aria-disabled="true"' : ''}
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2
              ${prevDisabled ? 'text-slate-300 cursor-not-allowed' : 'text-slate-600 hover:bg-slate-100 cursor-pointer'}"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            Previous
          </button>

          <span class="text-xs text-slate-400">${currentIdx + 1} of ${questions.length}</span>

          <button
            id="next-btn"
            onclick="navigate(1)"
            ${nextDisabled ? 'disabled aria-disabled="true"' : ''}
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2
              ${nextDisabled ? 'text-slate-300 cursor-not-allowed' : 'text-slate-600 hover:bg-slate-100 cursor-pointer'}"
          >
            Next
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    `;

    updateHeader();
  }

  (window as Window & typeof globalThis & Record<string, unknown>).handleOptionClick = (letter: string): void => {
    if (checkedState[currentIdx]) return;
    const q = questions[currentIdx];
    const selected = selectedAnswers[currentIdx];
    if (q.isMulti) {
      if (selected.has(letter)) selected.delete(letter);
      else selected.add(letter);
    } else {
      selected.clear();
      selected.add(letter);
    }
    renderQuestion();
  };

  (window as Window & typeof globalThis & Record<string, unknown>).checkAnswer = (): void => {
    if (selectedAnswers[currentIdx].size === 0) return;
    checkedState[currentIdx] = true;
    renderQuestion();
  };

  (window as Window & typeof globalThis & Record<string, unknown>).navigate = (delta: number): void => {
    const next = currentIdx + delta;
    if (next < 0 || next >= questions.length) return;
    currentIdx = next;
    renderQuestion();
  };

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key === ' ' || e.key === 'Spacebar') {
      if (!checkedState[currentIdx] && selectedAnswers[currentIdx].size > 0) {
        e.preventDefault();
        (window as any).checkAnswer();
      }
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      (window as any).navigate(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      (window as any).navigate(1);
    }
  });

  (window as Window & typeof globalThis & Record<string, unknown>).finishSession = async (): Promise<void> => {
    const answered = questions
      .map((q, i) => ({ q, i }))
      .filter(({ i }) => checkedState[i]);

    if (answered.length === 0) {
      showError('Answer at least one question before saving.');
      return;
    }

    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    saveBtn.textContent = 'Saving…';
    saveBtn.disabled = true;

    const timeTakenSecs = Math.floor((Date.now() - sessionStartTime) / 1000);
    let correctCount = 0;

    const questionData = answered.map(({ q, i }) => {
      const sel = selectedAnswers[i];
      const correct = isAnswerCorrect(sel, q.answer);
      if (correct) correctCount++;
      return {
        questionNumber: q.originalNumber,
        topic: q.topic,
        questionText: q.question,
        selectedAnswers: [...sel].sort(),
        correctAnswers: [...q.answer].sort(),
        isCorrect: correct,
      };
    });

    const score = Math.round((correctCount / answered.length) * 100);

    try {
      await saveAttempt({
        mode: 'PRACTICE',
        score,
        totalQuestions: answered.length,
        correctCount,
        timeTakenSecs,
        questions: questionData,
      });

      saveBtn.textContent = 'Saved!';
      saveBtn.className = 'text-sm font-semibold px-3 py-1.5 rounded-lg bg-green-600 text-white transition-colors cursor-default';
      setTimeout(() => {
        saveBtn.textContent = 'Save';
        saveBtn.disabled = false;
        saveBtn.className = 'text-sm font-semibold px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors cursor-pointer';
      }, 2500);
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Unknown error';
      showError(`Failed to save locally — ${message}`);
      saveBtn.textContent = 'Save';
      saveBtn.disabled = false;
    }
  };

  renderQuestion();
</script>
