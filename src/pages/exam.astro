---
import Layout from '../layouts/Layout.astro';
import questionsData from '../data/questions.json';
import type { RawQuestion } from '../types/question';

const questions = questionsData as RawQuestion[];
---
<Layout title="Exam Simulation – Exam Simulator">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="text-slate-400 hover:text-slate-700 transition-colors flex items-center gap-2 text-sm font-medium flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Exit
        </a>

        <!-- Timer -->
        <div id="timer-wrapper" class="flex items-center gap-2 bg-slate-100 px-4 py-1.5 rounded-full" role="timer" aria-label="Time remaining" aria-live="off">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span id="timer" class="text-sm font-bold text-slate-700 tabular-nums">1:45:00</span>
        </div>

        <div class="flex items-center gap-3">
          <span id="exam-counter" class="text-sm text-slate-500 font-medium flex-shrink-0" aria-live="polite">1 / {questions.length}</span>
          <button
            onclick="submitExam()"
            id="submit-btn"
            class="bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition-colors cursor-pointer flex-shrink-0"
            aria-label="Submit exam"
          >
            Submit
          </button>
        </div>
      </div>
      <div class="h-1 bg-slate-100" role="progressbar" aria-label="Exam progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="exam-progress-bar" class="h-1 bg-violet-500 transition-all duration-300" style="width: 0%"></div>
      </div>
    </header>

    <!-- Error banner -->
    <div
      id="error-banner"
      class="hidden max-w-3xl mx-auto w-full px-4 pt-4"
      role="alert"
      aria-live="assertive"
    >
      <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <span id="error-banner-text">Could not save results locally.</span>
      </div>
    </div>

    <!-- Keyboard hint -->
    <div class="max-w-3xl mx-auto w-full px-4 pt-3 pb-0">
      <p class="text-xs text-slate-400">
        Keyboard: <kbd class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 font-mono">←</kbd> Previous &nbsp;
        <kbd class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-500 font-mono">→</kbd> Next
      </p>
    </div>

    <!-- Main content -->
    <main id="main-content" class="flex-1 max-w-3xl mx-auto w-full px-4 py-8" tabindex="-1">
      <div id="exam-area"></div>
    </main>
  </div>
</Layout>

<script>
  import { normalizeQuestions, escapeHtml, formatTime, isAnswerCorrect } from '../lib/questionUtils';
  import { saveAttempt, resetProgress } from '../lib/db';
  import type { Rating } from '../lib/db';
  import type { RawQuestion } from '../types/question';
  import questionsRaw from '../data/questions.json';

  const EXAM_SECONDS = 105 * 60;

  const questions = normalizeQuestions(questionsRaw as unknown as RawQuestion[]);
  const selectedAnswers: Set<string>[] = questions.map(() => new Set());

  let currentIdx = 0;
  let secondsLeft = EXAM_SECONDS;
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let examFinished = false;
  const ratingByQNum: Record<number, Rating> = {};

  const timerEl = document.getElementById('timer') as HTMLElement;
  const timerWrapper = document.getElementById('timer-wrapper') as HTMLElement;
  const counterEl = document.getElementById('exam-counter') as HTMLElement;
  const progressBar = document.getElementById('exam-progress-bar') as HTMLElement;
  const progressBarWrapper = progressBar.parentElement as HTMLElement;
  const area = document.getElementById('exam-area') as HTMLElement;
  const errorBanner = document.getElementById('error-banner') as HTMLElement;
  const errorBannerText = document.getElementById('error-banner-text') as HTMLElement;

  function showError(message: string): void {
    errorBannerText.textContent = message;
    errorBanner.classList.remove('hidden');
  }

  function startTimer(): void {
    timerInterval = setInterval(() => {
      secondsLeft--;
      timerEl.textContent = formatTime(secondsLeft);
      if (secondsLeft <= 600 && secondsLeft > 60) {
        timerWrapper.className = 'flex items-center gap-2 bg-amber-100 px-4 py-1.5 rounded-full';
        timerEl.className = 'text-sm font-bold text-amber-700 tabular-nums';
      } else if (secondsLeft <= 60) {
        timerWrapper.className = 'flex items-center gap-2 bg-red-100 px-4 py-1.5 rounded-full';
        timerEl.className = 'text-sm font-bold text-red-600 tabular-nums animate-pulse';
      }
      if (secondsLeft <= 0) {
        clearInterval(timerInterval!);
        (window as any).submitExam();
      }
    }, 1000);
  }

  function updateHeader(): void {
    counterEl.textContent = `${currentIdx + 1} / ${questions.length}`;
    const pct = ((currentIdx + 1) / questions.length) * 100;
    progressBar.style.width = `${pct}%`;
    progressBarWrapper.setAttribute('aria-valuenow', String(Math.round(pct)));
    timerEl.textContent = formatTime(secondsLeft);
  }

  function answeredCount(): number {
    return selectedAnswers.filter((s) => s.size > 0).length;
  }

  function renderQuestion(): void {
    if (examFinished) return;
    const q = questions[currentIdx];
    const selected = selectedAnswers[currentIdx];

    const optionsHtml = q.options.map(([letter, text]) => {
      const isSelected = selected.has(letter);
      const baseCls = 'w-full text-left px-5 py-4 rounded-xl border-2 transition-all duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 ';
      const cls = isSelected
        ? baseCls + 'border-violet-500 bg-violet-50 text-slate-800'
        : baseCls + 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50';

      const icon = isSelected
        ? `<span class="w-6 h-6 rounded-full border-2 border-violet-500 bg-violet-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </span>`
        : `<span class="w-6 h-6 rounded-full border-2 border-slate-300 bg-white flex-shrink-0" aria-hidden="true"></span>`;

      return `
        <button
          class="${cls}"
          data-letter="${letter}"
          onclick="handleExamOption('${letter}')"
          aria-pressed="${isSelected}"
          aria-label="Option ${letter}: ${escapeHtml(text)}"
        >
          <div class="flex items-start gap-3">
            ${icon}
            <span class="leading-relaxed text-sm">${escapeHtml(text)}</span>
          </div>
        </button>
      `;
    }).join('');

    const prevDisabled = currentIdx === 0;
    const nextDisabled = currentIdx === questions.length - 1;
    const answered = answeredCount();

    area.innerHTML = `
      <div>
        ${q.topic ? `<div class="mb-3"><span class="text-xs font-semibold text-violet-600 bg-violet-50 border border-violet-100 px-2.5 py-1 rounded-full">${escapeHtml(q.topic)}</span></div>` : ''}

        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Question ${currentIdx + 1}</span>
          ${q.isMulti ? `<span class="text-xs bg-amber-100 text-amber-700 font-semibold px-2.5 py-0.5 rounded-full">Select ${q.answer.length} answers</span>` : ''}
          ${selected.size > 0 ? '<span class="text-xs bg-violet-100 text-violet-700 font-semibold px-2.5 py-0.5 rounded-full">Answered</span>' : ''}
        </div>

        <h2 class="text-lg font-semibold text-slate-800 mb-6 leading-relaxed whitespace-pre-line">
          ${escapeHtml(q.question)}
        </h2>

        <div class="flex flex-col gap-3 mb-8" role="group" aria-label="Answer options">
          ${optionsHtml}
        </div>

        <div class="flex items-center justify-between pt-6 border-t border-slate-200">
          <button
            onclick="examNavigate(-1)"
            ${prevDisabled ? 'disabled aria-disabled="true"' : ''}
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2
              ${prevDisabled ? 'text-slate-300 cursor-not-allowed' : 'text-slate-600 hover:bg-slate-100 cursor-pointer'}"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            Previous
          </button>

          <span class="text-xs text-slate-400" aria-live="polite">${answered} of ${questions.length} answered</span>

          <button
            onclick="examNavigate(1)"
            ${nextDisabled ? 'disabled aria-disabled="true"' : ''}
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2
              ${nextDisabled ? 'text-slate-300 cursor-not-allowed' : 'text-slate-600 hover:bg-slate-100 cursor-pointer'}"
          >
            Next
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>

        <!-- Question map -->
        <div class="mt-8 pt-6 border-t border-slate-200">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3" id="qmap-label">Question Map</p>
          <div class="flex flex-wrap gap-1.5" role="group" aria-labelledby="qmap-label">
            ${questions.map((_, i) => {
              const isAnswered = selectedAnswers[i].size > 0;
              const isCurrent = i === currentIdx;
              let cls = 'w-7 h-7 rounded text-xs font-semibold flex items-center justify-center cursor-pointer transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-1 ';
              if (isCurrent) cls += 'ring-2 ring-offset-1 ring-violet-500 ';
              cls += isAnswered ? 'bg-violet-500 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200';
              return `<button class="${cls}" onclick="jumpTo(${i})" aria-label="Go to question ${i + 1}${isAnswered ? ', answered' : ''}" aria-current="${isCurrent ? 'true' : 'false'}">${i + 1}</button>`;
            }).join('')}
          </div>
        </div>
      </div>
    `;

    updateHeader();
  }

  (window as Window & typeof globalThis & Record<string, unknown>).handleExamOption = (letter: string): void => {
    if (examFinished) return;
    const q = questions[currentIdx];
    const selected = selectedAnswers[currentIdx];
    if (q.isMulti) {
      if (selected.has(letter)) selected.delete(letter);
      else selected.add(letter);
    } else {
      selected.clear();
      selected.add(letter);
    }
    renderQuestion();
  };

  (window as Window & typeof globalThis & Record<string, unknown>).examNavigate = (delta: number): void => {
    const next = currentIdx + delta;
    if (next < 0 || next >= questions.length) return;
    currentIdx = next;
    renderQuestion();
  };

  (window as Window & typeof globalThis & Record<string, unknown>).jumpTo = (idx: number): void => {
    currentIdx = idx;
    renderQuestion();
  };

  (window as Window & typeof globalThis & Record<string, unknown>).submitExam = (): void => {
    if (examFinished) return;
    examFinished = true;
    if (timerInterval !== null) clearInterval(timerInterval);
    showResults();
  };

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (examFinished) return;
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      (window as any).examNavigate(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      (window as any).examNavigate(1);
    }
  });

  async function showResults(): Promise<void> {
    const timeTaken = EXAM_SECONDS - secondsLeft;
    const hh = Math.floor(timeTaken / 3600);
    const mm = Math.floor((timeTaken % 3600) / 60);
    const ss = timeTaken % 60;
    const timeStr = hh > 0 ? `${hh}h ${mm}m ${ss}s` : `${mm}m ${ss}s`;

    let correct = 0;
    const results = questions.map((q, i) => {
      const sel = selectedAnswers[i];
      const isCorrect = isAnswerCorrect(sel, q.answer);
      if (isCorrect) correct++;
      return { q, sel, isCorrect, i };
    });

    const score = Math.round((correct / questions.length) * 100);
    const passed = score >= 68;

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    submitBtn.style.display = 'none';
    timerWrapper.innerHTML = `<span class="text-xs font-semibold text-slate-500">Time: ${timeStr}</span>`;

    area.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm" role="status" aria-live="polite">Saving results…</div>`;

    let saveError: string | null = null;
    try {
      const { ratings } = await saveAttempt({
        mode: 'EXAM',
        score,
        totalQuestions: questions.length,
        correctCount: correct,
        timeTakenSecs: timeTaken,
        questions: results.map(({ q, sel, isCorrect }) => ({
          questionNumber: q.originalNumber,
          topic: q.topic,
          questionText: q.question,
          selectedAnswers: [...sel].sort(),
          correctAnswers: [...q.answer].sort(),
          isCorrect,
        })),
      });
      Object.assign(ratingByQNum, ratings);
    } catch (err) {
      saveError = err instanceof Error ? err.message : 'Unknown error';
      showError(`Could not save results locally — ${saveError}`);
    }

    const savedBanner = !saveError
      ? `<p class="mt-3 text-xs text-green-600 font-medium">Results saved — knowledge levels shown below.</p>`
      : `<p class="mt-3 text-xs text-red-500 font-medium">Results not saved locally (${saveError}).</p>`;

    const ratingCfg: Record<string, { cls: string; label: string }> = {
      GREEN:  { cls: 'bg-green-100 text-green-800',  label: 'Green — consistent' },
      YELLOW: { cls: 'bg-amber-100 text-amber-800',  label: 'Yellow — improving' },
      RED:    { cls: 'bg-red-100 text-red-800',      label: 'Red — needs work' },
    };

    area.innerHTML = `
      <div>
        <div class="bg-white border-2 ${passed ? 'border-green-400' : 'border-red-400'} rounded-2xl p-8 text-center mb-8" role="region" aria-label="Exam result">
          <div class="text-6xl font-bold mb-2 ${passed ? 'text-green-600' : 'text-red-600'}">${score}%</div>
          <div class="text-xl font-semibold ${passed ? 'text-green-700' : 'text-red-700'} mb-1">
            ${passed ? 'PASSED' : 'NOT PASSED'}
          </div>
          <p class="text-slate-500 text-sm mb-5">Passing score: 68%</p>
          <div class="flex justify-center gap-8 text-sm">
            <div><div class="text-2xl font-bold text-slate-800">${correct}</div><div class="text-slate-500">Correct</div></div>
            <div><div class="text-2xl font-bold text-slate-800">${questions.length - correct}</div><div class="text-slate-500">Incorrect</div></div>
            <div><div class="text-2xl font-bold text-slate-800">${selectedAnswers.filter((s) => s.size === 0).length}</div><div class="text-slate-500">Skipped</div></div>
          </div>
          ${savedBanner}
        </div>

        <div class="flex gap-3 mb-8">
          <a href="/exam" class="flex-1 text-center bg-violet-600 hover:bg-violet-700 text-white font-semibold px-4 py-3 rounded-xl transition-colors text-sm">Retake Exam</a>
          <a href="/" class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-4 py-3 rounded-xl transition-colors text-sm">Back to Home</a>
          <button onclick="handleReset()" class="flex-1 text-center bg-red-100 hover:bg-red-200 text-red-700 font-semibold px-4 py-3 rounded-xl transition-colors text-sm cursor-pointer">Reset Progress</button>
        </div>

        <h3 class="text-base font-bold text-slate-700 mb-4">Review Answers</h3>
        <div class="flex flex-col gap-4">
          ${results.map(({ q, sel, isCorrect, i }) => {
            const selLetters = [...sel].sort().join(', ') || '—';
            const correctLetters = [...q.answer].sort().join(', ');
            const rating = ratingByQNum[q.originalNumber];
            const ratingSection = rating
              ? `<div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2">
                  <span class="text-xs text-slate-400 font-medium">Knowledge level:</span>
                  <span class="text-xs font-bold px-3 py-1 rounded-full ${ratingCfg[rating].cls}">${ratingCfg[rating].label}</span>
                </div>`
              : '';

            return `
              <div class="bg-white border-2 ${isCorrect ? 'border-green-300' : 'border-red-300'} rounded-xl p-5">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Q${i + 1}</span>
                    ${q.topic ? `<span class="text-xs font-semibold text-violet-600 bg-violet-50 border border-violet-100 px-2 py-0.5 rounded-full">${escapeHtml(q.topic)}</span>` : ''}
                  </div>
                  ${isCorrect
                    ? '<span class="text-xs bg-green-100 text-green-700 font-semibold px-2.5 py-0.5 rounded-full flex-shrink-0">Correct</span>'
                    : '<span class="text-xs bg-red-100 text-red-700 font-semibold px-2.5 py-0.5 rounded-full flex-shrink-0">Incorrect</span>'}
                </div>
                <p class="text-sm font-medium text-slate-800 mb-3 leading-relaxed whitespace-pre-line">${escapeHtml(q.question)}</p>
                <div class="flex flex-col gap-1.5" role="list">
                  ${q.options.map(([letter, text]) => {
                    const wasSelected = sel.has(letter);
                    const isCorrectOpt = q.answer.includes(letter);
                    let cls = 'flex items-start gap-2 px-3 py-2 rounded-lg text-xs ';
                    if (isCorrectOpt && wasSelected) cls += 'bg-green-100 text-green-800';
                    else if (isCorrectOpt && !wasSelected) cls += 'bg-green-50 text-green-700 border border-green-200';
                    else if (!isCorrectOpt && wasSelected) cls += 'bg-red-100 text-red-800';
                    else cls += 'text-slate-400';
                    return `<div class="${cls}" role="listitem"><span class="font-bold flex-shrink-0">${escapeHtml(letter)}.</span><span>${escapeHtml(text)}</span></div>`;
                  }).join('')}
                </div>
                ${!isCorrect ? `<p class="mt-3 text-xs text-slate-500">Your answer: <strong>${selLetters}</strong> · Correct: <strong>${correctLetters}</strong></p>` : ''}
                <details class="mt-3">
                  <summary class="text-xs text-violet-600 font-semibold cursor-pointer hover:text-violet-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500 rounded">Show explanation</summary>
                  ${q.paraphrase ? `<p class="mt-2 text-xs font-semibold text-slate-500 uppercase tracking-wide">In a nutshell</p><p class="mt-1 text-xs text-slate-800 font-medium leading-relaxed mb-3 whitespace-pre-line">${escapeHtml(q.paraphrase)}</p>` : ''}
                  <p class="mt-2 text-xs text-slate-600 leading-relaxed whitespace-pre-line">${escapeHtml(q.explanation)}</p>
                </details>
                ${ratingSection}
              </div>
            `;
          }).join('')}
        </div>
      </div>
    `;
  }

  (window as Window & typeof globalThis & Record<string, unknown>).handleReset = async (): Promise<void> => {
    if (!confirm('Reset all progress? Every question will be treated as new on your next session.')) return;
    await resetProgress();
    window.location.href = '/';
  };

  renderQuestion();
  startTimer();
</script>
